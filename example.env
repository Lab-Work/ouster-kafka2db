# ouster-kafka2db configuration — copy this file to `.env`.
#
# The blank values below (credentials) must be supplied; everything else is
# pre-filled with the code's defaults, which are the Nashville deployment's.

# ---- Kafka (where detections are read from) ----------------------------
KAFKA_BOOTSTRAP=bootstrap.kafka.mogi.io:31090
KAFKA_USER=
KAFKA_PASSWORD=
KAFKA_CA_LOCATION=strimzi-ca.crt
# Or supply the broker CA as an inline PEM string instead of a file path
# (takes precedence over KAFKA_CA_LOCATION when set):
# KAFKA_CA_CERT=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# The real production topic is literally `my-topic`. ouster2kafka calls the
# same topic KAFKA_TOPIC_OBJECTS on its side; the two must agree. A wrong name
# fails silently (the consumer receives nothing).
KAFKA_TOPIC=my-topic
# Shared by every worker and every replica: the broker splits the partitions
# across them. The old writer committed offsets to this same group, so the new
# one resumes where it stopped. NEVER run the old and the new writer together.
KAFKA_GROUP_ID=ouster2db_objects
# Only used for a partition that has no committed offset in the group.
KAFKA_AUTO_OFFSET_RESET=latest

# ---- Postgres (where rows are written) ----------------------------------
# One database. Rows go to laddms.object_detections and
# laddms.broadway_object_detections.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DBNAME=NDOT
# executemany (default, the old writer's method) or copy (opt-in; benchmark
# it first, see README "COPY vs executemany").
DB_INSERT_METHOD=executemany
# Server-side limit per statement (ms) so a stuck insert ends, plus the
# connect timeout (s).
DB_STATEMENT_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_S=10
# Exit non-zero (the container restarts) once the database has been
# unwritable this long. Must keep DB_OUTAGE_EXIT_S + DB_STATEMENT_TIMEOUT_MS/1000
# under 300 s (Kafka's max.poll.interval.ms); startup refuses otherwise.
DB_OUTAGE_EXIT_S=180

# ---- Service settings ----------------------------------------------------
SERVICE_NAME=ouster_kafka2db
# Worker processes in this container, each one consumer-group member. Total
# workers across all containers/pods should equal the topic's partition count
# (3 today). On k8s use WORKERS=1 and scale with replicas.
WORKERS=3
# One batch = one Postgres transaction = one offset commit.
BATCH_MAX_MESSAGES=300
BATCH_TIMEOUT_S=1.0
# On partition assignment, if the committed offset is further behind than
# this many seconds, skip to the newest offset (logged at ERROR with the gap).
# 0 disables: always resume from the committed offset.
LAG_SKIP_AFTER_S=3600
# Kafka keys (install ids) whose rows go to laddms.broadway_object_detections.
BROADWAY_INTERSECTION_IDS=11,12,13,14,15
# Written to every row's device_id column.
DEVICE_ID=kafka_objects

# ---- Telemetry ----------------------------------------------------------
# Logs (JSON on stdout) and the Prometheus /metrics endpoint are on
# automatically. The whole toggle set is listed below so it is visible in one
# place; every line is commented out and shows the value the connector uses
# when it is left unset.
# TELEMETRY_METRICS=true
# Base port: worker i serves TELEMETRY_METRICS_PORT + i.
# TELEMETRY_METRICS_PORT=9100
# TELEMETRY_METRICS_ADDR=0.0.0.0
# TELEMETRY_LOG_LEVEL=INFO
#
# Profiling: activate to record where your code spends its CPU time (shows up
# as flame graphs in Grafana). Off by default — flip TELEMETRY_PROFILING to
# true, point TELEMETRY_PYROSCOPE_SERVER at the Pyroscope endpoint, and fill in
# the write password below.
# TELEMETRY_PROFILING=false
# TELEMETRY_PYROSCOPE_SERVER=https://lvtelemetry.isis.vanderbilt.edu/pyroscope
#
# Tracing: off by default. Flip TELEMETRY_TRACING to true to export OTLP/HTTP
# spans; auth reuses TELEMETRY_WRITE_USER / TELEMETRY_WRITE_PASSWORD below. The
# collector endpoint is deployment-specific — fill in the URL for your
# environment. The sample rate is a float in [0,1]; 1.0 records every span.
# TELEMETRY_TRACING=false
# TELEMETRY_OTLP_ENDPOINT=https://lvtelemetry.isis.vanderbilt.edu/otlp/v1/traces
# TELEMETRY_TRACE_SAMPLE_RATE=1.0
#
# TELEMETRY_WRITE_USER=ingest
# TELEMETRY_WRITE_PASSWORD=
#
# NOTE: TELEMETRY_WRITE_USER / TELEMETRY_WRITE_PASSWORD are not
# profiling-only, and they are not dead. They are the shared lvtelemetry
# `ingest` push credential used by every push path (profiles and traces), and
# they are also what lv_telemetry_connector's dev/metrics-sidecar consumes via
# --env-file when a developer scrapes a CLI-run service. Keep them declared
# even when profiling and tracing are both off.
